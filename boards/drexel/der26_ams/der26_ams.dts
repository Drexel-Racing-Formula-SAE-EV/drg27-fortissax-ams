/dts-v1/;

#include <st/f7/stm32f767Xi.dtsi>
#include <st/f7/stm32f767zitx-pinctrl.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
    model = "Drexel Racing DER26 AMS";
    compatible = "st,stm32f767";

    aliases {
        /* Standard Zephyr watchdog device; no custom AMS watchdog binding. */
        ams-watchdog = &iwdg;
    };

    chosen {
        zephyr,console = &usart3;
        zephyr,shell-uart = &usart3;
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zephyr,dtcm = &dtcm;
    };

    /*
     * Typed AMS board interfaces.
     *
     * Application-facing hardware contracts live in custom Devicetree nodes
     * rather than the untyped /zephyr,user escape hatch.  The bindings under
     * dts/bindings/ams make missing/malformed properties a configuration-time
     * error before C compilation begins.
     */
    ams_safety_io: ams-safety-io {
        compatible = "drexel,ams-safety-io";
        bms-ok-gpios = <&gpioe 0 GPIO_ACTIVE_HIGH>;
        status = "okay";
    };

    ams_adbms_interface: ams-adbms-interface {
        compatible = "drexel,ams-adbms-interface";
        cs-a-gpios = <&gpioe 2 GPIO_ACTIVE_LOW>;
        cs-b-gpios = <&gpioe 4 GPIO_ACTIVE_LOW>;
        status = "disabled";
    };

    /* Z-011 acquisition order is intentionally HIGH then LOW. */
    ams_current_sense: ams-current-sense {
        compatible = "drexel,ams-current-sense";
        io-channels = <&adc1 3>, <&adc2 10>;
        io-channel-names = "high", "low";
        status = "okay";
    };

    /*
     * Z-012 fan consumer mapping. PWM_HZ(32133) is Devicetree metadata for
     * the consumer; fan_pwm_zephyr.c uses exact cycle-domain period=3361 to
     * preserve ARR=3360 at the validated 108 MHz timer clock.
     */
    ams_fans: ams-fan-bank {
        compatible = "drexel,ams-fan-bank";
        pwms = <&pwm3 2 PWM_HZ(32133) PWM_POLARITY_NORMAL>,
               <&pwm3 4 PWM_HZ(32133) PWM_POLARITY_NORMAL>,
               <&pwm4 3 PWM_HZ(32133) PWM_POLARITY_NORMAL>,
               <&pwm4 4 PWM_HZ(32133) PWM_POLARITY_NORMAL>,
               <&pwm5 1 PWM_HZ(32133) PWM_POLARITY_NORMAL>,
               <&pwm5 2 PWM_HZ(32133) PWM_POLARITY_NORMAL>;
        pwm-names = "fan1", "fan2", "fan3", "fan4", "fan5", "fan6";
        status = "okay";
    };

    /*
     * Z-013 IMD interface. The pwms period cell describes the NORMAL-state
     * 10 Hz encoding only; capture mode measures period/pulse in hardware and
     * does not configure the input from this consumer period value.
     */
    ams_imd: ams-imd {
        compatible = "drexel,ams-imd";
        pwms = <&pwm2 1 PWM_HZ(10) PWM_POLARITY_NORMAL>;
        status-gpios = <&gpioc 5 GPIO_ACTIVE_HIGH>;
        status = "okay";
    };
};


/*
 * DER26 uses an actual 8 MHz HSE crystal.
 * Do NOT set hse-bypass.
 */
&clk_hse {
    clock-frequency = <DT_FREQ_M(8)>;
    status = "okay";
};


/*
 * STM32F767 clock tree:
 *
 * 8 MHz / 4 = 2 MHz
 * 2 MHz * 216 = 432 MHz VCO
 * 432 MHz / 2 = 216 MHz SYSCLK
 */
&pll {
    div-m = <4>;
    mul-n = <216>;
    div-p = <2>;
    div-q = <2>;
    clocks = <&clk_hse>;
    status = "okay";
};


&rcc {
    clocks = <&pll>;
    clock-frequency = <DT_FREQ_M(216)>;

    ahb-prescaler = <1>;
    apb1-prescaler = <4>;
    apb2-prescaler = <2>;
};


/*
 * Diagnostic UART.
 *
 * This is the only application peripheral enabled during Z-002.
 */
&usart3 {
    pinctrl-0 = <&usart3_tx_pd8 &usart3_rx_pd9>;
    pinctrl-names = "default";
    current-speed = <115200>;
    status = "okay";
};


/*
 * CAN1 / bxCAN hardware contract.
 *
 * Disabled until the later CAN migration phase.
 */
&can1 {
    pinctrl-0 = <&can1_rx_pd0 &can1_tx_pd1>;
    pinctrl-names = "default";
    status = "disabled";
};


/*
 * ADBMS SPI6 hardware contract.
 *
 * CS_A = PE2 and CS_B = PE4 are intentionally handled separately.
 *
 * String-B CS is PE4. Do not remap it.
 */
&spi6 {
    pinctrl-0 = <&spi6_sck_pg13
                 &spi6_miso_pg12
                 &spi6_mosi_pg14>;
    pinctrl-names = "default";
    status = "disabled";
};


/*
 * High-range DHAB current channel.
 * C_SENSE_H = PA3 / ADC1_IN3 / +/-800 A.
 *
 * Preserve the v2.6.27 ADC contract: synchronous PCLK2/6, 12-bit, one
 * software-triggered sample, no oversampling/DMA, 480-cycle acquisition.
 */
&adc1 {
    pinctrl-0 = <&adc1_in3_pa3>;
    pinctrl-names = "default";
    st,adc-clock-source = "SYNC";
    st,adc-prescaler = <6>;
    vref-mv = <3300>;
    status = "okay";

    #address-cells = <1>;
    #size-cells = <0>;

    channel@3 {
        reg = <3>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_VDD_1";
        zephyr,vref-mv = <3300>;
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 480)>;
        zephyr,resolution = <12>;
        zephyr,oversampling = <0>;
    };
};


/*
 * Low-range DHAB current channel.
 * C_SENSE_L = PC0 / ADC2_IN10 / +/-50 A.
 */
&adc2 {
    pinctrl-0 = <&adc2_in10_pc0>;
    pinctrl-names = "default";
    st,adc-clock-source = "SYNC";
    st,adc-prescaler = <6>;
    vref-mv = <3300>;
    status = "okay";

    #address-cells = <1>;
    #size-cells = <0>;

    channel@a {
        reg = <10>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_VDD_1";
        zephyr,vref-mv = <3300>;
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 480)>;
        zephyr,resolution = <12>;
        zephyr,oversampling = <0>;
    };
};

/*
 * Z-013 IMD PWM-input capture.
 *
 * v2.6.27 TIM2 uses no prescaling, 32-bit up-counting, CH1 direct rising
 * capture for the period, CH2 indirect falling capture for high time, and
 * hardware slave RESET mode on TI1FP1. Zephyr STM32 two-channel PWM capture
 * configures that same topology when channel 1 capture is requested and
 * four-channel-capture-support is left disabled.
 */
&timers2 {
    /* v2.6.27 CubeMX sets TIM2_IRQn preemption priority to 5. Keep the
     * capture interrupt at the same NVIC priority rather than inheriting the
     * STM32 SoC DTS default. */
    interrupts = <28 5>;
    st,prescaler = <0>;
    status = "okay";

    pwm2: pwm {
        pinctrl-0 = <&tim2_ch1_pa5>;
        pinctrl-names = "default";
        status = "okay";
    };
};

/*
 * Z-012 cooling fan PWM hardware contract.
 *
 * v2.6.27 uses APB1 timer clock 108 MHz, prescaler 0, up-counting PWM1 and
 * ARR=3360. Zephyr pwm_stm32 programs ARR=period_cycles-1 for up-counters, so
 * the adapter requests 3361 cycles and preserves the original timer period.
 */
&timers3 {
    st,prescaler = <0>;
    status = "okay";

    pwm3: pwm {
        pinctrl-0 = <&tim3_ch2_pa7 &tim3_ch4_pb1>;
        pinctrl-names = "default";
        status = "okay";
    };
};

&timers4 {
    st,prescaler = <0>;
    status = "okay";

    pwm4: pwm {
        pinctrl-0 = <&tim4_ch3_pd14 &tim4_ch4_pd15>;
        pinctrl-names = "default";
        status = "okay";
    };
};

&timers5 {
    st,prescaler = <0>;
    status = "okay";

    pwm5: pwm {
        pinctrl-0 = <&tim5_ch1_pa0 &tim5_ch2_pa1>;
        pinctrl-names = "default";
        status = "okay";
    };
};


/* Z-014 standard STM32 independent watchdog mechanism. Merely enabling the
 * device does not start IWDG in Zephyr 4.4; the AMS platform adapter installs
 * its timeout during prepare and crosses the irreversible wdt_setup() boundary
 * only in the explicit validation configuration. */
&iwdg {
    status = "okay";
};
