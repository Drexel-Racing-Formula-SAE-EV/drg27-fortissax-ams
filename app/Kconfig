mainmenu "DRG27 Fortissax AMS"

source "Kconfig.zephyr"

menu "DRG27 AMS migration safety policy"

config AMS_BMS_AUTHORITY
    bool "Permit BMS_OK assertion authority"
    default n
    help
      Controls whether the application is allowed to contain BMS_OK
      assertion authority.

      This MUST remain disabled during the early Zephyr migration.
      Z-003 also enforces this with a C BUILD_ASSERT.

config AMS_BALANCE_AUTHORITY
    bool "Permit balancing authority"
    default n
    help
      Controls whether the application is allowed to command cell
      balancing.

      This MUST remain disabled during the early Zephyr migration.
      Z-003 also enforces this with a C BUILD_ASSERT.

config AMS_IMD_TARGET_VALIDATED
    bool "Claim physical IMD target validation"
    default n
    help
      Release-evidence gate corresponding to the v2.6.27
      AMS_IMD_TARGET_VALIDATED build gate. Z-013 must remain disabled:
      this stage proves source/SIL/target-build behavior only and does not
      claim physical PWM/status validation of the installed IMD.

config AMS_FAN_TARGET_VALIDATED
    bool "Claim physical fan PWM target validation"
    default n
    help
      Release-evidence gate for physical fan PWM validation. Z-013 must remain
      disabled until reset/pinctrl behavior, frequency, polarity and all six
      physical outputs have been verified on the installed target.

config AMS_IWDG_VALIDATION_MODE
    bool "Arm STM32 IWDG for explicit Z-014 hardware validation"
    default n
    help
      Compile the Z-014 watchdog port in irreversible active mode. When this
      is disabled the adapter is still built and safely prepared, but
      wdt_setup() is never called and IWDG is not armed.

      Keep this disabled in the ordinary migration build. Enable only in the
      dedicated watchdog validation configuration while BMS and balancing
      authority remain disabled.

config AMS_WATCHDOG_TARGET_VALIDATED
    bool "Claim physical watchdog target validation"
    depends on AMS_IWDG_VALIDATION_MODE
    default n
    help
      Evidence gate only. Do not enable from a successful compile/link. This
      remains false until healthy feeding, deliberate starvation, supervisor
      death, process-fault non-reset, stack-margin and reset-cause tests have
      been demonstrated on the installed STM32F767 target.

config AMS_IWDG_STOP_FEED_TEST_AFTER_MS
    int "Validation-only automatic watchdog starvation delay (ms)"
    depends on AMS_IWDG_VALIDATION_MODE
    default 0
    range 0 600000
    help
      Zero disables automatic starvation. A nonzero value causes the safety
      supervisor to stop feeding after the requested runtime age so the real
      IWDG reset path can be measured. This option never grants authority.

endmenu
menu "DRG27 AMS migration capabilities"

# Hidden migration facts.  These are intentionally not user-selectable: code
# presence, actor liveness, safety evidence, and physical validation are four
# different states and must never be inferred from one another.
config AMS_CAP_BMS_OK_PLATFORM_ADAPTER_PRESENT
    bool
    default y

config AMS_CAP_CURRENT_ADC_ADAPTER_PRESENT
    bool
    default y

config AMS_CAP_CURRENT_ACTOR_LIVE
    bool
    default n

config AMS_CAP_CURRENT_SAFETY_EVIDENCE
    bool
    default n

config AMS_CAP_ADBMS_SPI_ADAPTER_PRESENT
    bool
    default n

config AMS_CAP_ADBMS_ACTOR_LIVE
    bool
    default n

config AMS_CAP_ADBMS_SAFETY_EVIDENCE
    bool
    default n

config AMS_CAP_TEMPERATURE_SAFETY_EVIDENCE
    bool
    default n

config AMS_CAP_CAN_ADAPTER_PRESENT
    bool
    default n

config AMS_CAP_CAN_ACTOR_LIVE
    bool
    default n

config AMS_CAP_CAN_SAFETY_EVIDENCE
    bool
    default n

config AMS_CAP_FAN_PWM_ADAPTER_PRESENT
    bool
    default y

config AMS_CAP_FAN_ACTOR_LIVE
    bool
    default y

config AMS_CAP_FAN_SAFETY_EVIDENCE
    bool
    default y

config AMS_CAP_FAN_PHYSICAL_VALIDATED
    bool
    default y if AMS_FAN_TARGET_VALIDATED
    default n

config AMS_CAP_IMD_CAPTURE_ADAPTER_PRESENT
    bool
    default y

config AMS_CAP_IMD_ACTOR_LIVE
    bool
    default y

config AMS_CAP_IMD_SAFETY_EVIDENCE
    bool
    default y

config AMS_CAP_IMD_PHYSICAL_VALIDATED
    bool
    default y if AMS_IMD_TARGET_VALIDATED
    default n

config AMS_CAP_WATCHDOG_ADAPTER_PRESENT
    bool
    default y

config AMS_CAP_WATCHDOG_ACTIVE
    bool
    default y if AMS_IWDG_VALIDATION_MODE
    default n

config AMS_CAP_WATCHDOG_PHYSICAL_VALIDATED
    bool
    default y if AMS_WATCHDOG_TARGET_VALIDATED
    default n

config AMS_CAP_WATCHDOG_FULL_ORACLE_COVERAGE
    bool
    default n

endmenu
