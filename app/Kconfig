mainmenu "DRG27 Fortissax AMS"

source "Kconfig.zephyr"

menu "DRG27 AMS migration safety policy"

config AMS_BMS_AUTHORITY
    bool "Permit BMS_OK assertion authority"
    default n
    help
      Controls whether the application is allowed to contain BMS_OK
      assertion authority.

      This MUST remain disabled during the early Zephyr migration.
      Z-003 also enforces this with a C BUILD_ASSERT.

config AMS_BALANCE_AUTHORITY
    bool "Permit balancing authority"
    default n
    help
      Controls whether the application is allowed to command cell
      balancing.

      This MUST remain disabled during the early Zephyr migration.
      Z-003 also enforces this with a C BUILD_ASSERT.

config AMS_IMD_TARGET_VALIDATED
    bool "Claim physical IMD target validation"
    default n
    help
      Release-evidence gate corresponding to the v2.6.27
      AMS_IMD_TARGET_VALIDATED build gate. Z-013 must remain disabled:
      this stage proves source/SIL/target-build behavior only and does not
      claim physical PWM/status validation of the installed IMD.

config AMS_FAN_TARGET_VALIDATED
    bool "Claim physical fan PWM target validation"
    default n
    help
      Release-evidence gate for physical fan PWM validation. Z-013 must remain
      disabled until reset/pinctrl behavior, frequency, polarity and all six
      physical outputs have been verified on the installed target.


config AMS_CURRENT_ADC_PRIVATE_BACKEND
    bool
    default y
    select USE_STM32_LL_ADC
    select RESET
    help
      Private bounded STM32F767 ADC1/ADC2 polling backend for the dual-range
      current sensor. The generic Zephyr ADC subsystem intentionally does not
      own these ADC instances; this avoids an uncancellable async adc_context
      transaction and restores the v2.6.27 recover-after-timeout behavior.

config AMS_ADBMS_SPI_PRIVATE_BACKEND
    bool
    default y
    select USE_STM32_LL_SPI
    select RESET
    help
      Z-015 private STM32F767 SPI6 transport backend. The generic Zephyr SPI
      subsystem intentionally does not own SPI6. This hidden migration fact
      enables only the STM32 LL SPI module plus Zephyr reset-controller API.

config AMS_IWDG_VALIDATION_MODE
    bool "Arm STM32 IWDG for explicit Z-014 hardware validation"
    default n
    help
      Compile the Z-014 watchdog port in irreversible active mode. When this
      is disabled the adapter is still built and safely prepared, but
      wdt_setup() is never called and IWDG is not armed.

      Keep this disabled in the ordinary migration build. Enable only in the
      dedicated watchdog validation configuration while BMS and balancing
      authority remain disabled.

config AMS_WATCHDOG_TARGET_VALIDATED
    bool "Claim physical watchdog target validation"
    depends on AMS_IWDG_VALIDATION_MODE
    default n
    help
      Evidence gate only. Do not enable from a successful compile/link. This
      remains false until healthy feeding, deliberate starvation, supervisor
      death, process-fault non-reset, stack-margin and reset-cause tests have
      been demonstrated on the installed STM32F767 target.

config AMS_IWDG_STOP_FEED_TEST_AFTER_MS
    int "Validation-only automatic watchdog starvation delay (ms)"
    depends on AMS_IWDG_VALIDATION_MODE
    default 0
    range 0 600000
    help
      Zero disables automatic starvation. A nonzero value causes the safety
      supervisor to stop feeding after the requested runtime age so the real
      IWDG reset path can be measured. This option never grants authority.

config AMS_Z016_LINK_PROBE
    bool "Finite String B one-SMB read-only isoSPI probe"
    default n
    select CORTEX_M_SYSTICK_64BIT_CYCLE_COUNTER
    help
      Temporary ADBMS6822 evaluation-jumper path on PE4 only. No onboard
      String A fallback, configuration writes, conversion, S diagnostics,
      balancing, APM or vehicle authority. Stops on the first failed step.

config AMS_Z017_CELL_VALIDATION
    bool "String B one-SMB ADBMS6830 cell-acquisition validation"
    depends on !AMS_Z016_LINK_PROBE
    default n
    select CORTEX_M_SYSTICK_64BIT_CYCLE_COUNTER
    help
      No-authority Z017 acquisition profile. The priority-3 ADBMS owner uses
      String B / PE4 only, initializes one ADBMS6830B, runs startup POST, and
      acquires 15 C-authoritative cells plus advisory AVG8/IIR products. This
      does not grant BMS_OK, balancing, temperature, APM, estimator, or ADBMS
      watchdog safety authority.

config AMS_Z018_TEMP_VALIDATION
    bool "String B cell and 24-temperature validation"
    depends on !AMS_Z016_LINK_PROBE
    depends on !AMS_Z017_CELL_VALIDATION
    default n
    select CORTEX_M_SYSTICK_64BIT_CYCLE_COUNTER
    help
      Enables the three-mux temperature scan in the existing ADBMS owner.
      Temperature hardware is previously validated; Zephyr parity is pending.
      Acquisition grants no safety evidence or vehicle authority.

config AMS_Z019_RECOVERY_VALIDATION
    bool "Z019 protocol recovery over the Z018 acquisition profile"
    depends on AMS_Z018_TEMP_VALIDATION
    default n
    help
      Audit SID and safe configuration before acquisition. An interruption
      withdraws old epochs; one bounded remote reinitialization attempt may
      run on the next owner release. Failure latches until reboot.
      This grants no watchdog safety evidence or vehicle authority.

config AMS_Z018_AUX2_DIAGNOSTIC
    bool "Advisory AUX2 comparison"
    depends on AMS_Z018_TEMP_VALIDATION
    default n

config AMS_Z018_THERM_OW_DIAGNOSTIC
    bool "Advisory thermistor open-wire diagnostic"
    depends on AMS_Z018_TEMP_VALIDATION
    default n

config AMS_Z023_SUPERVISION_VALIDATION
    bool "Z023 shadow supervision and owner progress validation"
    depends on AMS_Z022_MEASUREMENT_VALIDATION
    default n
    help
      Copied fault supervision and owner progress; safety evidence remains off.

config AMS_Z022_MEASUREMENT_VALIDATION
    bool "Z022 single-SMB measurement publication validation"
    depends on AMS_Z020_BALANCE_DISABLED_VALIDATION
    default n
    help
      Enable current sampling and copied single-SMB measurement epochs.
      No full-pack estimator or safety evidence is claimed.

config AMS_Z020_BALANCE_DISABLED_VALIDATION
    bool "Z020 disabled balancing and diagnostic shadow validation"
    depends on AMS_Z019_RECOVERY_VALIDATION
    depends on !AMS_BALANCE_AUTHORITY && !AMS_BMS_AUTHORITY
    default n
    help
      Keep MUTE, zero DCC/timers/PWM and per-release Z019 audits.
      Publish an advisory shadow mask; no active balancing transport.

endmenu
menu "DRG27 AMS migration capabilities"

# Hidden migration facts.  These are intentionally not user-selectable: code
# presence, actor liveness, safety evidence, and physical validation are four
# different states and must never be inferred from one another.
config AMS_CAP_BMS_OK_PLATFORM_ADAPTER_PRESENT
    bool
    default y

config AMS_CAP_CURRENT_ADC_ADAPTER_PRESENT
    bool
    default y

config AMS_CAP_CURRENT_ACTOR_LIVE
    bool
    default y if AMS_Z022_MEASUREMENT_VALIDATION
    default n

config AMS_CAP_CURRENT_SAFETY_EVIDENCE
    bool
    default n

config AMS_CAP_ADBMS_SPI_ADAPTER_PRESENT
    bool
    default y

config AMS_CAP_ADBMS_SPI_PHYSICAL_VALIDATED
    bool
    default n

config AMS_CAP_ADBMS_ACTOR_LIVE
    bool
    default y if AMS_Z017_CELL_VALIDATION || AMS_Z018_TEMP_VALIDATION
    default n

config AMS_CAP_ADBMS_MONITOR_ACQUISITION_LIVE
    bool
    default y if AMS_Z017_CELL_VALIDATION || AMS_Z018_TEMP_VALIDATION
    default n

config AMS_CAP_ADBMS_SAFETY_EVIDENCE
    bool
    default n

config AMS_CAP_TEMPERATURE_ACQUISITION_LIVE
    bool
    default y if AMS_Z018_TEMP_VALIDATION
    default n

config AMS_CAP_TEMPERATURE_SAFETY_EVIDENCE
    bool
    default n

config AMS_CAP_CAN_ADAPTER_PRESENT
    bool
    default n

config AMS_CAP_CAN_ACTOR_LIVE
    bool
    default n

config AMS_CAP_CAN_SAFETY_EVIDENCE
    bool
    default n

config AMS_CAP_FAN_PWM_ADAPTER_PRESENT
    bool
    default y

config AMS_CAP_FAN_ACTOR_LIVE
    bool
    default y

config AMS_CAP_FAN_SAFETY_EVIDENCE
    bool
    default y

config AMS_CAP_FAN_PHYSICAL_VALIDATED
    bool
    default y if AMS_FAN_TARGET_VALIDATED
    default n

config AMS_CAP_IMD_CAPTURE_ADAPTER_PRESENT
    bool
    default y

config AMS_CAP_IMD_ACTOR_LIVE
    bool
    default y

config AMS_CAP_IMD_SAFETY_EVIDENCE
    bool
    default y

config AMS_CAP_IMD_PHYSICAL_VALIDATED
    bool
    default y if AMS_IMD_TARGET_VALIDATED
    default n

config AMS_CAP_WATCHDOG_ADAPTER_PRESENT
    bool
    default y

config AMS_CAP_WATCHDOG_ACTIVE
    bool
    default y if AMS_IWDG_VALIDATION_MODE
    default n

config AMS_CAP_WATCHDOG_PHYSICAL_VALIDATED
    bool
    default y if AMS_WATCHDOG_TARGET_VALIDATED
    default n

config AMS_CAP_WATCHDOG_FULL_ORACLE_COVERAGE
    bool
    default n

endmenu
